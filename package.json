{
  "name": "studytrack",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @studytrack/web dev",
    "build": "pnpm --filter @studytrack/web build",
    "start": "pnpm --filter @studytrack/web start",
    "test": "pnpm --filter @studytrack/engine test && node --test studytrack/apps/web/src/__tests__/web.test.mjs && node scripts/eval-prompts.mjs",
    "test:engine": "pnpm --filter @studytrack/engine test",
    "test:web": "pnpm --filter @studytrack/web test",
    "eval:prompts": "node scripts/eval-prompts.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @studytrack/web lint"
  }
}
